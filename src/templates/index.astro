---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/ui/Hero.astro";
import Section from "../components/ui/Section.astro";
import Container from "../components/ui/Container.astro";
import ProductCard from "../components/ui/ProductCard.astro";
import Button from "../components/ui/Button.astro";
import { getContactLabels, getContactLinks } from "../data/contactLinks";
import { getLocaleFromPath, getPageText } from "../utils/i18n";

const text = getPageText(Astro.url.pathname);
const locale = getLocaleFromPath(Astro.url.pathname);
const contactLinks = getContactLinks(locale);
const contactLabels = getContactLabels(locale);

const sections = [
  {
    title: text("text9"),
    label: text("text10"),
    description: text("text11"),
    href: "/produtos/",
  },
  {
    title: text("text12"),
    label: text("text13"),
    description: text("text14"),
    href: "/nichos/",
  },
  {
    title: text("text15"),
    label: text("text16"),
    description: text("text17"),
    href: "/tecidos/",
  },
  {
    title: text("text18"),
    label: text("text19"),
    description: text("text20"),
    href: "/blog/",
  },
];
---

<BaseLayout
>
  <Hero
    eyebrow={text("text22")}
    title={text("text2")}
    text={text("text23")}
    primaryCta={{
      label: contactLabels.whatsapp,
      href: contactLinks.whatsapp,
      target: "_blank",
      event: "cta_whatsapp",
      location: "home-hero",
    }}
    secondaryCta={{
      label: contactLabels.store,
      href: contactLinks.store,
      target: "_blank",
      event: "cta_store",
      location: "home-hero",
    }}
  />

  <Section background="surface">
    <Container>
      <div class="cards-grid">
        {sections.map((s) => (
          <ProductCard title={s.title} label={s.label} description={s.description} href={s.href} />
        ))}
      </div>
    </Container>
  </Section>

  <Section background="surface-soft" spacing="tight">
    <Container size="narrow" class="cta">
      <h2 class="cta__title">{text("text3")}</h2>
      <p class="cta__text">
        {text("text4")}
      </p>
      <div class="cta__actions">
        <Button href="/nichos/" variant="primary" size="lg" data-event="cta_nichos" data-location="home-main">
          {text("text5")}
        </Button>
        <Button href="/produtos/" variant="secondary" size="lg" data-event="cta_produtos" data-location="home-main">
          {text("text6")}
        </Button>
        <Button
          href={contactLinks.store}
          target="_blank"
          variant="secondary"
          size="lg"
          data-event="cta_store"
          data-location="home-main"
        >
          {contactLabels.store}
        </Button>
      </div>
    </Container>
  </Section>

  <Section background="bg" spacing="tight">
    <Container size="narrow">
      <div class="contact-section">
        <div class="contact-section__intro">
          <h2>{text("text7")}</h2>
          <p>
              {text("text8")}
            </p>
        </div>

        <div class="contact-grid">
          <article class="contact-card">
            <h3 class="contact-card__title">{text("text24")}</h3>
            <p class="contact-card__text">{text("text25")}</p>
            <Button
              href={contactLinks.whatsapp}
              target="_blank"
              variant="secondary"
              size="lg"
              data-event="cta_whatsapp"
              data-location="home-contact"
            >
              {contactLabels.whatsapp}
            </Button>
          </article>

          <article class="contact-card">
            <h3 class="contact-card__title">{text("text26")}</h3>
            <p class="contact-card__text">{text("text27")}</p>
            <Button
              href={contactLinks.instagram}
              target="_blank"
              variant="secondary"
              size="lg"
              data-event="cta_instagram"
              data-location="home-contact"
            >
              {contactLabels.instagram}
            </Button>
          </article>

          <article class="contact-card">
            <h3 class="contact-card__title">{text("text28")}</h3>
            <p class="contact-card__text">{text("text29")}</p>
            <Button
              href={contactLinks.email}
              variant="secondary"
              size="lg"
              data-event="cta_email"
              data-location="home-contact"
            >
              {contactLabels.email}
            </Button>
          </article>
        </div>
      </div>
    </Container>
  </Section>
</BaseLayout>

<style>
  .cards-grid {
    display: grid;
    gap: var(--space-6);
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
  }

  .cta {
    text-align: center;
  }

  .cta__title {
    font-size: clamp(24px, 4vw, 36px);
  }

  .cta__text {
    margin-top: var(--space-4);
    color: var(--color-muted);
  }

  .cta__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-3);
    margin-top: var(--space-6);
  }

  .cta__micro-link {
    margin-top: var(--space-4);
    font-size: 14px;
  }

  .cta__micro-link a {
    color: var(--color-muted);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
</style>
