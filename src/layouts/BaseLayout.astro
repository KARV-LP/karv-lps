---
import "../styles/global.css";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import {
  documentLanguage,
  getLocaleFromPath,
  getPage,
  getPathFromLocalePath,
  localizedPath,
  ogLocale,
  t,
  type Locale
} from "../utils/i18n";

interface Props {
  locale?: Locale;
  path?: string;
  title?: string;
  description?: string;
  criticalImage?: {
    src: string;
    srcset: string;
    sizes: string;
  };
}

const {
  locale = getLocaleFromPath(Astro.url.pathname),
  path = getPathFromLocalePath(Astro.url.pathname),
  title: suppliedTitle = "KARV Platform",
  description: suppliedDescription = "Plataforma digital oficial da KARV.",
  criticalImage
} = Astro.props;
const localizedSeo = getPage(locale, path)?.seo;
const title = localizedSeo?.title ?? suppliedTitle;
const description = localizedSeo?.description ?? suppliedDescription;
const canonicalURL = new URL(localizedPath(locale, path), Astro.site);
const portugueseURL = new URL(localizedPath("pt", path), Astro.site);
const englishURL = new URL(localizedPath("en", path), Astro.site);
---

<!doctype html>
<html lang={documentLanguage(locale)}>
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    {criticalImage && (
      <link
        rel="preload"
        as="image"
        href={criticalImage.src}
        imagesrcset={criticalImage.srcset}
        imagesizes={criticalImage.sizes}
        type="image/avif"
        fetchpriority="high"
      />
    )}
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" hreflang="pt-BR" href={portugueseURL} />
    <link rel="alternate" hreflang="en" href={englishURL} />
    <link rel="alternate" hreflang="x-default" href={portugueseURL} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <meta name="theme-color" content="#181513" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:locale" content={ogLocale(locale)} />
    <meta property="og:locale:alternate" content={ogLocale(locale === "pt" ? "en" : "pt")} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">{t(locale, "accessibility").skipToContent}</a>
    <Header locale={locale} path={path} />
    <main id="main-content">
      <slot />
    </main>
    <Footer locale={locale} />
  </body>
</html>
