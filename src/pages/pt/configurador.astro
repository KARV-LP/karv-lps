---
import BaseLayout from "../../layouts/BaseLayout.astro";
const configuratorUrl = "https://personalize.k-arv.com/configurador";
---
<BaseLayout locale="pt" path="configurador" title="Configurador 3D | KARV" description="Personalize a poltrona KARV oficial, área por área, com tecidos e estampas KARV.">
  <section class="mx-auto grid min-h-[calc(100vh-12rem)] max-w-karv content-center gap-karv-6 px-karv-4 py-karv-12">
    <p class="font-karv-text text-karv-sm uppercase tracking-[0.16em] text-karv-accent">Experiência KARV</p>
    <h1 class="max-w-3xl font-karv-display text-karv-4xl font-bold leading-karv-display text-karv-paper">Configure a sua poltrona, área por área.</h1>
    <p class="max-w-2xl text-karv-lg text-karv-muted">Explore tecidos e estampas KARV diretamente na poltrona oficial. A configuração acontece em uma experiência 3D dedicada.</p>
    <div class="flex flex-wrap gap-karv-3">
      <a class="rounded-karv-pill bg-karv-accent px-karv-5 py-karv-3 font-karv-text font-bold text-karv-ink transition hover:bg-karv-accent-soft" href={configuratorUrl}>Abrir configurador 3D</a>
      <a class="rounded-karv-pill border border-karv-border px-karv-5 py-karv-3 font-karv-text font-bold text-karv-paper transition hover:border-karv-accent" href="/pt/tecidos/">Explorar tecidos</a>
    </div>
  </section>
</BaseLayout>