---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Hero from "../../../components/ui/Hero.astro";
import Section from "../../../components/ui/Section.astro";
import Container from "../../../components/ui/Container.astro";
import Button from "../../../components/ui/Button.astro";
import { getContactLabels, getContactLinks } from "../../../data/contactLinks";
import { getLocaleFromPath, getPageText } from "../../../utils/i18n";

const text = getPageText(Astro.url.pathname);
const locale = getLocaleFromPath(Astro.url.pathname);
const contactLinks = getContactLinks(locale);
const contactLabels = getContactLabels(locale);
---

<BaseLayout
>
  <Hero
    eyebrow={text("text32")}
    title={text("text2")}
    text={text("text33")}
    primaryCta={{ label: text("text34"), href: "/produtos/" }}
    secondaryCta={{ label: text("text30"), href: contactLinks.whatsapp }}
  />

  <Section background="surface">
    <Container class="content">
      <div class="intro">
        <h2>{text("text3")}</h2>
        <p>
          {text("text4")}
        </p>
      </div>
    </Container>
  </Section>

  <Section background="bg">
    <Container>
      <div class="grid">
        <article class="card">
          <h3>{text("text5")}</h3>
          <p>
            {text("text6")}
          </p>
        </article>
        <article class="card">
          <h3>{text("text7")}</h3>
          <ul class="card__list">
            <li>{text("text8")}</li>
            <li>{text("text9")}</li>
            <li>{text("text10")}</li>
          </ul>
        </article>
      </div>
    </Container>
  </Section>

  <Section background="surface-soft">
    <Container>
      <div class="section-heading">
        <h2>{text("text11")}</h2>
        <p>{text("text12")}</p>
      </div>
      <div class="grid grid--three">
        <article class="card">
          <h3>{text("text13")}</h3>
          <p>{text("text14")}</p>
        </article>
        <article class="card">
          <h3>{text("text15")}</h3>
          <p>{text("text16")}</p>
        </article>
        <article class="card">
          <h3>{text("text17")}</h3>
          <p>{text("text18")}</p>
        </article>
      </div>
    </Container>
  </Section>

  <Section background="surface">
    <Container>
      <div class="section-heading">
        <h2>{text("text19")}</h2>
        <p>{text("text20")}</p>
      </div>
      <div class="grid grid--three">
        <article class="card">
          <h3>{text("text21")}</h3>
          <p>{text("text22")}</p>
        </article>
        <article class="card">
          <h3>{text("text23")}</h3>
          <p>{text("text24")}</p>
        </article>
        <article class="card">
          <h3>{text("text25")}</h3>
          <p>{text("text26")}</p>
        </article>
      </div>
    </Container>
  </Section>

  <Section background="bg" spacing="tight">
    <Container size="narrow" class="cta">
      <h2>{text("text27")}</h2>
      <p>
        {text("text28")}
      </p>
      <div class="actions">
        <Button href="/produtos/" variant="primary" size="lg">{text("text29")}</Button>
        <Button
          href={contactLinks.whatsapp}
          target="_blank"
          variant="secondary"
          size="lg"
          data-event="cta_whatsapp"
          data-location="nicho"
        >
          {text("text30")}
        </Button>
      </div>
    </Container>
  </Section>
</BaseLayout>

<style>
  .content {
    display: grid;
    gap: var(--space-6);
  }

  .intro {
    max-width: 760px;
  }

  .intro h2,
  .section-heading h2,
  .cta h2 {
    font-size: clamp(24px, 3.5vw, 34px);
    margin-bottom: var(--space-4);
  }

  .intro p,
  .section-heading p,
  .cta p,
  .card p,
  .card li {
    color: var(--color-muted);
  }

  .grid {
    display: grid;
    gap: var(--space-6);
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  }

  .grid--three {
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  }

  .card {
    padding: var(--space-6);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .card h3 {
    font-size: 20px;
  }

  .card__list {
    display: grid;
    gap: var(--space-2);
    padding-left: var(--space-4);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-3);
    margin-top: var(--space-6);
  }

  .cta {
    text-align: center;
  }
</style>
