---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Hero from "../../components/ui/Hero.astro";
import Section from "../../components/ui/Section.astro";
import Container from "../../components/ui/Container.astro";
import ProductCard from "../../components/ui/ProductCard.astro";
import Button from "../../components/ui/Button.astro";

const niches = [
  { title: "Barbearia", description: "Poltronas e ambientes que reforçam a identidade da barbearia moderna.", href: "/nichos/barbearia/" },
  { title: "Estética", description: "Conforto e sofisticação para salas de atendimento e espera.", href: "/nichos/estetica/" },
  { title: "Tatuagem", description: "Peças resistentes e estilosas para estúdios de tatuagem.", href: "/nichos/tatuagem/" },
  { title: "Clínicas", description: "Mobiliário institucional para recepções e salas de espera clínicas.", href: "/nichos/clinicas/" },
  { title: "Studios", description: "Ambientes com presença visual forte para studios criativos e premium.", href: "/nichos/studios/" },
  { title: "Odontologia", description: "Mobiliário que transmite confiança em clínicas odontológicas.", href: "/produtos/" },
  { title: "Podologia", description: "Soluções ergonômicas para consultórios de podologia.", href: "/produtos/" },
  { title: "Salões", description: "Ambientes premium para salões de beleza e estética capilar.", href: "/produtos/" },
];
---

<BaseLayout
  title="Nichos | KARV"
  description="Soluções KARV para clínicas, barbearias, estúdios, estética, odontologia e outros segmentos."
>
  <Hero
    eyebrow="Nichos"
    title="Segmentos estratégicos KARV"
    text="Cada segmento tem exigências próprias de conforto, durabilidade e apresentação. A KARV desenvolve poltronas e coleções pensadas para o dia a dia de cada nicho."
  />

  <Section background="surface">
    <Container>
      <div class="cards-grid">
        {niches.map((niche) => (
          <ProductCard title={niche.title} description={niche.description} href={niche.href} />
        ))}
      </div>
    </Container>
  </Section>

  <Section background="bg">
    <Container>
      <div class="cross-nav">
        <div class="cross-nav__intro">
          <p class="cross-nav__eyebrow">Conexão comercial</p>
          <h2 class="cross-nav__title">Aprofunde a proposta do segmento pelo produto e pelo tecido.</h2>
          <p class="cross-nav__text">
            Cada nicho ganha força quando o ambiente, a poltrona e a curadoria de revestimentos dialogam entre si.
          </p>
        </div>

        <div class="cross-nav__grid">
          <ProductCard
            title="Produtos de referência"
            description="Acompanhe as linhas KARV mais alinhadas à identidade do projeto."
            href="/produtos/"
          />
          <ProductCard
            title="Tecidos para o projeto"
            description="Conecte a linguagem visual do espaço à curadoria de revestimentos."
            href="/tecidos/"
          />
          <ProductCard
            title="Coleções KARV"
            description="Use a biblioteca como base para identidade, acabamento e experiência do ambiente."
            href="/tecidos/colecoes/"
          />
        </div>
      </div>
    </Container>
  </Section>

  <Section background="bg" spacing="tight">
    <Container size="narrow" class="cta">
      <h2 class="cta__title">Não encontrou o seu segmento?</h2>
      <p class="cta__text">
        A KARV atende novos nichos sob demanda. Explore as coleções e tecidos disponíveis para o seu projeto.
      </p>
      <Button href="/produtos/" variant="primary" size="lg">Ver produtos</Button>
    </Container>
  </Section>
</BaseLayout>

<style>
  .cards-grid {
    display: grid;
    gap: var(--space-6);
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  }

  .cross-nav {
    display: grid;
    gap: var(--space-8);
  }

  .cross-nav__eyebrow {
    color: var(--color-accent-soft);
    text-transform: uppercase;
    letter-spacing: 0.2em;
    font-size: 13px;
  }

  .cross-nav__title {
    margin-top: var(--space-3);
    font-size: clamp(24px, 3.5vw, 32px);
  }

  .cross-nav__text {
    margin-top: var(--space-4);
    max-width: 680px;
    color: var(--color-muted);
  }

  .cross-nav__grid {
    display: grid;
    gap: var(--space-6);
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  }

  .cta {
    text-align: center;
  }

  .cta__title {
    font-size: clamp(22px, 3.5vw, 32px);
  }

  .cta__text {
    margin-top: var(--space-4);
    color: var(--color-muted);
  }

  .cta :global(.btn) {
    margin-top: var(--space-6);
  }
</style>
