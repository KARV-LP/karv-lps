---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Hero from "../../components/ui/Hero.astro";
import Section from "../../components/ui/Section.astro";
import Container from "../../components/ui/Container.astro";
import ProductCard from "../../components/ui/ProductCard.astro";
import Button from "../../components/ui/Button.astro";
import { getPageText } from "../../utils/i18n";

const text = getPageText(Astro.url.pathname);

const niches = [
  { title: text("text12"), description: text("text13"), href: "/nichos/barbearia/" },
  { title: text("text14"), description: text("text15"), href: "/nichos/estetica/" },
  { title: text("text16"), description: text("text17"), href: "/nichos/tatuagem/" },
  { title: text("text18"), description: text("text19"), href: "/nichos/clinicas/" },
  { title: text("text20"), description: text("text21"), href: "/nichos/studios/" },
  { title: text("text22"), description: text("text23"), href: "/produtos/" },
  { title: text("text24"), description: text("text25"), href: "/produtos/" },
  { title: text("text26"), description: text("text27"), href: "/produtos/" },
];
---

<BaseLayout
>
  <Hero
    eyebrow={text("text29")}
    title={text("text2")}
    text={text("text30")}
  />

  <Section background="surface">
    <Container>
      <div class="cards-grid">
        {niches.map((niche) => (
          <ProductCard title={niche.title} description={niche.description} href={niche.href} />
        ))}
      </div>
    </Container>
  </Section>

  <Section background="bg">
    <Container>
      <div class="cross-nav">
        <div class="cross-nav__intro">
          <p class="cross-nav__eyebrow">{text("text6")}</p>
          <h2 class="cross-nav__title">{text("text7")}</h2>
          <p class="cross-nav__text">
            {text("text8")}
          </p>
        </div>

        <div class="cross-nav__grid">
          <ProductCard
            title={text("text3")}
            description="Acompanhe as linhas KARV mais alinhadas à identidade do projeto."
            href="/produtos/"
          />
          <ProductCard
            title={text("text4")}
            description={text("text31")}
            href="/tecidos/"
          />
          <ProductCard
            title={text("text5")}
            description={text("text32")}
            href="/tecidos/colecoes/"
          />
        </div>
      </div>
    </Container>
  </Section>

  <Section background="bg" spacing="tight">
    <Container size="narrow" class="cta">
      <h2 class="cta__title">{text("text9")}</h2>
      <p class="cta__text">
        {text("text10")}
      </p>
      <Button href="/produtos/" variant="primary" size="lg">{text("text11")}</Button>
    </Container>
  </Section>
</BaseLayout>

<style>
  .cards-grid {
    display: grid;
    gap: var(--space-6);
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  }

  .cross-nav {
    display: grid;
    gap: var(--space-8);
  }

  .cross-nav__eyebrow {
    color: var(--color-accent-soft);
    text-transform: uppercase;
    letter-spacing: 0.2em;
    font-size: 13px;
  }

  .cross-nav__title {
    margin-top: var(--space-3);
    font-size: clamp(24px, 3.5vw, 32px);
  }

  .cross-nav__text {
    margin-top: var(--space-4);
    max-width: 680px;
    color: var(--color-muted);
  }

  .cross-nav__grid {
    display: grid;
    gap: var(--space-6);
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  }

  .cta {
    text-align: center;
  }

  .cta__title {
    font-size: clamp(22px, 3.5vw, 32px);
  }

  .cta__text {
    margin-top: var(--space-4);
    color: var(--color-muted);
  }

  .cta :global(.btn) {
    margin-top: var(--space-6);
  }
</style>
