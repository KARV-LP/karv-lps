---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Hero from "../../../components/ui/Hero.astro";
import Section from "../../../components/ui/Section.astro";
import Container from "../../../components/ui/Container.astro";
import Button from "../../../components/ui/Button.astro";
---

<BaseLayout
  title="Fale com a KARV"
  description="Contato comercial da KARV para orçamentos, projetos e parcerias."
>
  <Hero
    eyebrow="Contato KARV"
    title="Fale com a KARV"
    text="Converse com a KARV para entender possibilidades de poltronas, tecidos e aplicações para o seu ambiente."
    primaryCta={{ label: "Voltar para home", href: "/" }}
  />

  <Section background="surface">
    <Container size="narrow">
      <div class="contact-card">
        <p class="contact-card__intro">
          Para atendimento comercial, escolha um dos canais abaixo e fale direto com a nossa equipe.
        </p>

        <div class="contact-grid">
          <article class="contact-card__item">
            <h3>WhatsApp</h3>
            <p>Atendimento comercial para projetos, orçamentos e dúvidas.</p>
            <Button href="https://wa.me/5511999999999" target="_blank" variant="secondary" size="lg">
              Chamar no WhatsApp
            </Button>
          </article>

          <article class="contact-card__item">
            <h3>Instagram</h3>
            <p>Acompanhe referências, coleções e bastidores da KARV.</p>
            <Button href="https://instagram.com/karv" target="_blank" variant="secondary" size="lg">
              Ver Instagram
            </Button>
          </article>

          <article class="contact-card__item">
            <h3>E-mail</h3>
            <p>Envie sua solicitação ou briefing inicial.</p>
            <Button href="mailto:contato@karv.com" variant="secondary" size="lg">
              Enviar e-mail
            </Button>
          </article>
        </div>
      </div>
    </Container>
  </Section>
</BaseLayout>

<style>
  .contact-card {
    display: grid;
    gap: var(--space-6);
    padding: var(--space-8);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
  }

  .contact-card__intro {
    color: var(--color-muted);
    line-height: 1.7;
  }

  .contact-grid {
    display: grid;
    gap: var(--space-6);
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
  }

  .contact-card__item {
    display: grid;
    gap: var(--space-4);
    padding: var(--space-6);
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-border);
    background: var(--color-bg);
  }

  .contact-card__item h3 {
    margin: 0;
    font-size: 1.15rem;
  }

  .contact-card__item p {
    margin: 0;
    color: var(--color-muted);
    line-height: 1.75;
  }
</style>
