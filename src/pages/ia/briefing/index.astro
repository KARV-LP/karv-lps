---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Section from "../../../components/ui/Section.astro";
import Container from "../../../components/ui/Container.astro";
import Button from "../../../components/ui/Button.astro";
import { KARV_CONTACT_LINKS, KARV_CONTACT_LABELS } from "../../../data/contactLinks";
---

<BaseLayout
  title="Fale com a KARV | Contato Comercial"
  description="Entre em contato com a KARV para conversar sobre poltronas comerciais que reforçam a identidade do seu ambiente."
>
  <Section background="surface-soft">
    <Container size="narrow">
      <div class="contact-hero">
        <p class="contact-hero__eyebrow">Contato comercial</p>
        <h1>Fale com a KARV</h1>
        <p>
          Conte sobre o seu ambiente e o tipo de presença que deseja criar. A KARV
          desenvolve poltronas que reforçam a identidade do espaço com conforto,
          expressão visual e aplicação comercial.
        </p>

        <div class="contact-actions">
          <Button
            href={KARV_CONTACT_LINKS.whatsapp}
            target="_blank"
            variant="primary"
            size="lg"
            data-event="cta_whatsapp"
            data-location="ia-briefing"
          >
            {KARV_CONTACT_LABELS.whatsapp}
          </Button>

          <Button
            href={KARV_CONTACT_LINKS.instagram}
            target="_blank"
            variant="secondary"
            size="lg"
            data-event="cta_instagram"
            data-location="ia-briefing"
          >
            {KARV_CONTACT_LABELS.instagram}
          </Button>

          <Button
            href={KARV_CONTACT_LINKS.email}
            variant="secondary"
            size="lg"
            data-event="cta_email"
            data-location="ia-briefing"
          >
            {KARV_CONTACT_LABELS.email}
          </Button>
        </div>
      </div>
    </Container>
  </Section>
</BaseLayout>

<style>
  .contact-hero {
    text-align: center;
  }

  .contact-hero__eyebrow {
    margin-bottom: var(--space-3);
    color: var(--color-accent-soft);
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .contact-hero h1 {
    margin-bottom: var(--space-4);
  }

  .contact-hero p {
    margin-inline: auto;
    max-width: 680px;
    color: var(--color-muted);
  }

  .contact-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-3);
    margin-top: var(--space-8);
  }
</style>
