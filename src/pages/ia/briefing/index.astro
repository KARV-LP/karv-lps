---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Section from "../../../components/ui/Section.astro";
import Container from "../../../components/ui/Container.astro";
import Button from "../../../components/ui/Button.astro";
import { getContactLabels, getContactLinks } from "../../../data/contactLinks";
import { getLocaleFromPath, getPageText } from "../../../utils/i18n";

const text = getPageText(Astro.url.pathname);
const locale = getLocaleFromPath(Astro.url.pathname);
const contactLinks = getContactLinks(locale);
const contactLabels = getContactLabels(locale);
---

<BaseLayout
>
  <Section background="surface-soft">
    <Container size="narrow">
      <div class="contact-hero">
        <p class="contact-hero__eyebrow">{text("text2")}</p>
        <h1>{text("text3")}</h1>
        <p>
          {text("text4")}
        </p>

        <div class="contact-actions">
          <Button
            href={contactLinks.whatsapp}
            target="_blank"
            variant="primary"
            size="lg"
            data-event="cta_whatsapp"
            data-location="ia-briefing"
          >
            {contactLabels.whatsapp}
          </Button>

          <Button
            href={contactLinks.instagram}
            target="_blank"
            variant="secondary"
            size="lg"
            data-event="cta_instagram"
            data-location="ia-briefing"
          >
            {contactLabels.instagram}
          </Button>

          <Button
            href={contactLinks.email}
            variant="secondary"
            size="lg"
            data-event="cta_email"
            data-location="ia-briefing"
          >
            {contactLabels.email}
          </Button>
        </div>
      </div>
    </Container>
  </Section>
</BaseLayout>

<style>
  .contact-hero {
    text-align: center;
  }

  .contact-hero__eyebrow {
    margin-bottom: var(--space-3);
    color: var(--color-accent-soft);
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .contact-hero h1 {
    margin-bottom: var(--space-4);
  }

  .contact-hero p {
    margin-inline: auto;
    max-width: 680px;
    color: var(--color-muted);
  }

  .contact-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-3);
    margin-top: var(--space-8);
  }
</style>
