---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---

<BaseLayout
  title="KARV Platform | Infraestrutura Digital"
  description="Plataforma digital oficial da KARV para landing pages, produtos, nichos, tecidos, SEO/GEO e integrações com Netlify Pro."
>
  <Header />

  <main class="page">
    <section class="hero">
      <p class="eyebrow">KARV Platform</p>
      <h1>Infraestrutura digital da KARV</h1>
      <p class="text">
        Base oficial para landing pages, produtos, nichos, biblioteca de tecidos,
        SEO/GEO, analytics e integrações com Netlify Pro.
      </p>

      <div class="links">
        <a href="/produtos/">Produtos</a>
        <a href="/nichos/">Nichos</a>
        <a href="/tecidos/">Tecidos</a>
        <a href="/blog/">Blog GEO</a>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  :global(body) {
    margin: 0;
    font-family: Inter, Arial, sans-serif;
    color: #f5f1e8;
    background:
      radial-gradient(circle at top right, rgba(174, 133, 76, 0.18), transparent 35%),
      #111111;
  }

  .page {
    min-height: 80vh;
    display: grid;
    place-items: center;
    padding: 32px;
  }

  .hero {
    max-width: 920px;
  }

  .eyebrow {
    color: #c9a36a;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    font-size: 14px;
    margin-bottom: 20px;
  }

  h1 {
    font-size: clamp(42px, 8vw, 96px);
    line-height: 0.95;
    margin: 0 0 24px;
  }

  .text {
    max-width: 700px;
    font-size: 20px;
    line-height: 1.6;
    color: #d8d2c4;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 36px;
  }

  .links a {
    border: 1px solid rgba(201, 163, 106, 0.35);
    border-radius: 999px;
    padding: 12px 18px;
    color: #f5f1e8;
    text-decoration: none;
    background: rgba(255, 255, 255, 0.04);
  }
</style>