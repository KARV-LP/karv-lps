---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/ui/Hero.astro";
import Section from "../components/ui/Section.astro";
import Container from "../components/ui/Container.astro";
import ProductCard from "../components/ui/ProductCard.astro";
import Button from "../components/ui/Button.astro";
import { KARV_CONTACT_LINKS, KARV_CONTACT_LABELS } from "../data/contactLinks";

const sections = [
  {
    title: "Produtos",
    label: "Coleções",
    description: "Poltronas e coleções KARV, pensadas para cada ambiente.",
    href: "/produtos/",
  },
  {
    title: "Nichos",
    label: "Segmentos",
    description: "Soluções para barbearias, clínicas, estética e outros segmentos.",
    href: "/nichos/",
  },
  {
    title: "Tecidos",
    label: "Biblioteca",
    description: "Tecidos e revestimentos selecionados para cada projeto.",
    href: "/tecidos/",
  },
  {
    title: "Blog GEO",
    label: "Conteúdo",
    description: "Conteúdo estratégico de SEO e autoridade de nicho.",
    href: "/blog/",
  },
];
---

<BaseLayout
  title="KARV Platform | Infraestrutura Digital"
  description="Plataforma digital oficial da KARV para landing pages, produtos, nichos, tecidos, SEO/GEO e integrações com Netlify Pro."
>
  <Hero
    eyebrow="KARV Platform"
    title="Infraestrutura digital da KARV"
    text="Base oficial para landing pages, produtos, nichos, biblioteca de tecidos, SEO/GEO, analytics e integrações com Netlify Pro."
    primaryCta={{ label: "Ver produtos", href: "/produtos/" }}
    secondaryCta={{ label: "Ver nichos", href: "/nichos/" }}
  />

  <Section background="surface">
    <Container>
      <div class="cards-grid">
        {sections.map((s) => (
          <ProductCard title={s.title} label={s.label} description={s.description} href={s.href} />
        ))}
      </div>
    </Container>
  </Section>

  <Section background="surface-soft" spacing="tight">
    <Container size="narrow" class="cta">
      <h2 class="cta__title">Fale com a KARV</h2>
      <p class="cta__text">
        Conte sobre o seu ambiente e o tipo de presença que deseja criar. A KARV
        desenvolve poltronas para reforçar a identidade do espaço com conforto,
        expressão visual e aplicação comercial.
      </p>
      <div class="cta__actions">
        <Button
          href={KARV_CONTACT_LINKS.whatsapp}
          target="_blank"
          variant="primary"
          size="lg"
          data-event="cta_whatsapp"
          data-location="home-main"
        >
          {KARV_CONTACT_LABELS.whatsapp}
        </Button>
        <Button href="/produtos/" variant="secondary" size="lg" data-event="cta_produtos" data-location="home-main">
          Ver produtos
        </Button>
      </div>
    </Container>
  </Section>

  <Section background="bg" spacing="tight">
    <Container size="narrow">
      <div class="contact-section">
        <div class="contact-section__intro">
          <h2>Fale com a KARV</h2>
          <p>
              Escolha o canal mais direto para iniciar uma proposta comercial e contar
              sobre o espaço que deseja transformar.
            </p>
        </div>

        <div class="contact-grid">
          <article class="contact-card">
            <h3 class="contact-card__title">WhatsApp</h3>
            <p class="contact-card__text">+55 11 94519-7063</p>
            <Button
              href={KARV_CONTACT_LINKS.whatsapp}
              target="_blank"
              variant="secondary"
              size="lg"
              data-event="cta_whatsapp"
              data-location="home-contact"
            >
              {KARV_CONTACT_LABELS.whatsapp}
            </Button>
          </article>

          <article class="contact-card">
            <h3 class="contact-card__title">Instagram</h3>
            <p class="contact-card__text">@karv.dna</p>
            <Button
              href={KARV_CONTACT_LINKS.instagram}
              target="_blank"
              variant="secondary"
              size="lg"
              data-event="cta_instagram"
              data-location="home-contact"
            >
              {KARV_CONTACT_LABELS.instagram}
            </Button>
          </article>

          <article class="contact-card">
            <h3 class="contact-card__title">E-mail</h3>
            <p class="contact-card__text">comercial.karv.sp@gmail.com</p>
            <Button
              href={KARV_CONTACT_LINKS.email}
              variant="secondary"
              size="lg"
              data-event="cta_email"
              data-location="home-contact"
            >
              {KARV_CONTACT_LABELS.email}
            </Button>
          </article>
        </div>
      </div>
    </Container>
  </Section>
</BaseLayout>

<style>
  .cards-grid {
    display: grid;
    gap: var(--space-6);
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
  }

  .cta {
    text-align: center;
  }

  .cta__title {
    font-size: clamp(24px, 4vw, 36px);
  }

  .cta__text {
    margin-top: var(--space-4);
    color: var(--color-muted);
  }

  .cta__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-3);
    margin-top: var(--space-6);
  }

  .cta__micro-link {
    margin-top: var(--space-4);
    font-size: 14px;
  }

  .cta__micro-link a {
    color: var(--color-muted);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
</style>
