---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/ui/Hero.astro";
import Section from "../components/ui/Section.astro";
import Container from "../components/ui/Container.astro";
import ProductCard from "../components/ui/ProductCard.astro";
import Button from "../components/ui/Button.astro";

const sections = [
  {
    title: "Produtos",
    label: "Coleções",
    description: "Poltronas e coleções KARV, pensadas para cada ambiente.",
    href: "/produtos/",
  },
  {
    title: "Nichos",
    label: "Segmentos",
    description: "Soluções para barbearias, clínicas, estética e outros segmentos.",
    href: "/nichos/",
  },
  {
    title: "Tecidos",
    label: "Biblioteca",
    description: "Tecidos e revestimentos selecionados para cada projeto.",
    href: "/tecidos/",
  },
  {
    title: "Blog GEO",
    label: "Conteúdo",
    description: "Conteúdo estratégico de SEO e autoridade de nicho.",
    href: "/blog/",
  },
];
---

<BaseLayout
  title="KARV Platform | Infraestrutura Digital"
  description="Plataforma digital oficial da KARV para landing pages, produtos, nichos, tecidos, SEO/GEO e integrações com Netlify Pro."
>
  <Hero
    eyebrow="KARV Platform"
    title="Infraestrutura digital da KARV"
    text="Base oficial para landing pages, produtos, nichos, biblioteca de tecidos, SEO/GEO, analytics e integrações com Netlify Pro."
    primaryCta={{ label: "Ver produtos", href: "/produtos/" }}
    secondaryCta={{ label: "Ver nichos", href: "/nichos/" }}
  />

  <Section background="surface">
    <Container>
      <div class="cards-grid">
        {sections.map((s) => (
          <ProductCard title={s.title} label={s.label} description={s.description} href={s.href} />
        ))}
      </div>
    </Container>
  </Section>

  <Section background="surface-soft" spacing="tight">
    <Container size="narrow" class="cta">
      <h2 class="cta__title">Pronto para elevar o padrão do seu espaço?</h2>
      <p class="cta__text">
        Conheça as poltronas e coleções KARV e encontre a combinação certa de tecido
        para o seu ambiente ou negócio.
      </p>
      <div class="cta__actions">
        <Button href="/produtos/" variant="primary" size="lg">Ver produtos</Button>
        <Button href="/tecidos/" variant="secondary" size="lg">Ver tecidos</Button>
      </div>
    </Container>
  </Section>
</BaseLayout>

<style>
  .cards-grid {
    display: grid;
    gap: var(--space-6);
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
  }

  .cta {
    text-align: center;
  }

  .cta__title {
    font-size: clamp(24px, 4vw, 36px);
  }

  .cta__text {
    margin-top: var(--space-4);
    color: var(--color-muted);
  }

  .cta__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-3);
    margin-top: var(--space-6);
  }
</style>
