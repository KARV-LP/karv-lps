---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Hero from "../../../components/ui/Hero.astro";
import Section from "../../../components/ui/Section.astro";
import Container from "../../../components/ui/Container.astro";
import Button from "../../../components/ui/Button.astro";
import { getPageText } from "../../../utils/i18n";

const text = getPageText(Astro.url.pathname);

const identityPoints = [
  text("text11"),
  text("text12"),
  text("text13"),
];

const applications = [
  text("text14"),
  text("text15"),
  text("text16"),
];

const materials = [
  text("text17"),
  text("text18"),
];

const benefits = [
  text("text19"),
  text("text20"),
  text("text24"),
];
---

<BaseLayout
>
  <Hero
    eyebrow="Nicho: clínica estética"
    title="KV_022 SOFT TAUPE"
    text={text("text21")}
    primaryCta={{ label: text("text22"), href: "/produtos/" }}
    secondaryCta={{ label: text("text23"), href: "/nichos/clinicas/" }}
  />

  <Section background="surface">
    <Container>
      <div class="intro-card">
        <p class="intro-card__eyebrow">{text("text1")}</p>
        <p class="intro-card__text">
          {text("text2")}
        </p>
      </div>
    </Container>
  </Section>

  <Section background="bg">
    <Container>
      <div class="feature-grid">
        <article class="feature-card">
          <h2 class="feature-card__title">{text("text3")}</h2>
          <ul class="feature-card__list">
            {identityPoints.map((point) => <li>{point}</li>)}
          </ul>
        </article>

        <article class="feature-card">
          <h2 class="feature-card__title">{text("text4")}</h2>
          <ul class="feature-card__list">
            {applications.map((point) => <li>{point}</li>)}
          </ul>
        </article>
      </div>
    </Container>
  </Section>

  <Section background="surface-soft">
    <Container>
      <div class="materials-block">
        <h2 class="materials-block__title">{text("text5")}</h2>
        <div class="materials-grid">
          {materials.map((material) => <div class="material-item">{material}</div>)}
        </div>
      </div>
    </Container>
  </Section>

  <Section background="bg">
    <Container>
      <div class="benefits-block">
        <h2 class="benefits-block__title">{text("text6")}</h2>
        <div class="benefits-grid">
          {benefits.map((benefit) => (
            <div class="benefit-item">{benefit}</div>
          ))}
        </div>
      </div>
    </Container>
  </Section>

  <Section background="bg" spacing="tight">
    <Container size="narrow" class="cta">
      <h2 class="cta__title">{text("text7")}</h2>
      <p class="cta__text">
        {text("text8")}
      </p>
      <div class="cta__actions">
        <Button href="/produtos/" variant="primary" size="lg">{text("text9")}</Button>
        <Button href="/tecidos/" variant="secondary" size="lg">{text("text10")}</Button>
      </div>
    </Container>
  </Section>
</BaseLayout>

<style>
  .intro-card {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-8);
    background: var(--color-surface);
  }

  .intro-card__eyebrow {
    color: var(--color-accent-soft);
    text-transform: uppercase;
    letter-spacing: 0.18em;
    font-size: 13px;
    margin-bottom: var(--space-3);
  }

  .intro-card__text {
    font-size: 18px;
    line-height: 1.7;
    color: var(--color-muted);
    max-width: 70ch;
  }

  .feature-grid {
    display: grid;
    gap: var(--space-6);
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  }

  .feature-card {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    background: var(--color-surface);
  }

  .feature-card__title {
    font-size: 22px;
    margin-bottom: var(--space-4);
  }

  .feature-card__list {
    display: grid;
    gap: var(--space-3);
    color: var(--color-muted);
    padding-left: 1.2rem;
  }

  .materials-block,
  .benefits-block {
    display: grid;
    gap: var(--space-6);
  }

  .materials-block__title,
  .benefits-block__title {
    font-size: 28px;
  }

  .materials-grid,
  .benefits-grid {
    display: grid;
    gap: var(--space-4);
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  }

  .material-item,
  .benefit-item {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-5);
    background: var(--color-surface);
    color: var(--color-muted);
  }

  .cta {
    text-align: center;
  }

  .cta__title {
    font-size: clamp(22px, 3.5vw, 32px);
  }

  .cta__text {
    margin-top: var(--space-4);
    color: var(--color-muted);
  }

  .cta__actions {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-6);
  }
</style>
