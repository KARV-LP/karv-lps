---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Hero from "../../components/ui/Hero.astro";
import Section from "../../components/ui/Section.astro";
import Container from "../../components/ui/Container.astro";
import ProductCard from "../../components/ui/ProductCard.astro";
import Button from "../../components/ui/Button.astro";

const categories = [
  {
    title: "KV-001 RYUJIN",
    label: "Poltrona autoral",
    description: "A poltrona que amplifica ambientes de identidade forte — studios de tatuagem, barbearias autorais e espaços expressivos.",
    href: "/produtos/kv-001-ryujin/",
  },
  {
    title: "Poltronas",
    description: "Modelos exclusivos KARV para ambientes residenciais e comerciais, unindo conforto e durabilidade.",
  },
  {
    title: "Coleções",
    description: "Linhas completas pensadas para cada estilo de projeto, do executivo ao contemporâneo.",
  },
];
---

<BaseLayout
  title="Produtos | KARV"
  description="Poltronas e coleções KARV — área base para produtos e páginas individuais."
>
  <Hero
    eyebrow="Produtos"
    title="Poltronas e coleções KARV"
    text="Da poltrona executiva à peça sob medida, cada linha KARV é desenvolvida para unir conforto, durabilidade e identidade visual ao seu espaço."
  />

  <Section background="surface">
    <Container>
      <div class="cards-grid">
        {categories.map((c) => (
          <ProductCard title={c.title} label={c.label} description={c.description} href={c.href ?? "/produtos/"} />
        ))}
      </div>
    </Container>
  </Section>

  <Section background="bg" spacing="tight">
    <Container size="narrow" class="cta">
      <h2 class="cta__title">Encontre o tecido ideal para a sua poltrona</h2>
      <p class="cta__text">
        Explore a biblioteca de tecidos e revestimentos KARV e combine com a coleção certa para o seu projeto.
      </p>
      <Button href="/tecidos/" variant="primary" size="lg">Ver tecidos</Button>
    </Container>
  </Section>
</BaseLayout>

<style>
  .cards-grid {
    display: grid;
    gap: var(--space-6);
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
  }

  .cta {
    text-align: center;
  }

  .cta__title {
    font-size: clamp(22px, 3.5vw, 32px);
  }

  .cta__text {
    margin-top: var(--space-4);
    color: var(--color-muted);
  }

  .cta :global(.btn) {
    margin-top: var(--space-6);
  }
</style>
