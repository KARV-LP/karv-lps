---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Hero from "../../components/ui/Hero.astro";
import Section from "../../components/ui/Section.astro";
import Container from "../../components/ui/Container.astro";
import ProductCard from "../../components/ui/ProductCard.astro";
import Button from "../../components/ui/Button.astro";
import { getPageText } from "../../utils/i18n";

const text = getPageText(Astro.url.pathname);

const products = [
  {
    title: text("text15"),
    description: text("text16"),
    href: "/produtos/kv-001-ryujin/",
  },
  {
    title: text("text17"),
    description: text("text18"),
    href: "/produtos/kv-002-mandala/",
  },
  {
    title: text("text19"),
    description: text("text20"),
    href: "/produtos/kv-020-pure-balance/",
  },
  {
    title: text("text21"),
    description: text("text22"),
    href: "/produtos/kv-021-natural-beauty/",
  },
  {
    title: text("text23"),
    description: text("text24"),
    href: "/produtos/kv-022-soft-taupe/",
  },
];
---

<BaseLayout
>
  <Hero
    eyebrow={text("text25")}
    title={text("text2")}
    text={text("text26")}
  />

  <Section background="surface">
    <Container>
      <div class="cards-grid">
        {products.map((product) => (
          <ProductCard title={product.title} description={product.description} href={product.href} />
        ))}
      </div>
    </Container>
  </Section>

  <Section background="bg">
    <Container>
      <div class="cross-nav">
        <div class="cross-nav__intro">
          <p class="cross-nav__eyebrow">{text("text3")}</p>
          <h2 class="cross-nav__title">{text("text4")}</h2>
          <p class="cross-nav__text">
            {text("text5")}
          </p>
        </div>

        <div class="cross-nav__grid">
          <div class="cross-nav__group">
            <h3>{text("text6")}</h3>
            <div class="cross-nav__actions">
              <Button href="/nichos/barbearia/" variant="secondary">{text("text7")}</Button>
              <Button href="/nichos/clinicas/" variant="secondary">{text("text8")}</Button>
              <Button href="/nichos/estetica/" variant="secondary">{text("text9")}</Button>
            </div>
          </div>

          <div class="cross-nav__group">
            <h3>{text("text10")}</h3>
            <div class="cross-nav__actions">
              <Button href="/tecidos/premium/" variant="secondary">{text("text11")}</Button>
              <Button href="/tecidos/clinicas-esteticas/" variant="secondary">{text("text8")}</Button>
              <Button href="/tecidos/barbearia/" variant="secondary">{text("text7")}</Button>
            </div>
          </div>
        </div>
      </div>
    </Container>
  </Section>

  <Section background="bg" spacing="tight">
    <Container size="narrow" class="cta">
      <h2 class="cta__title">{text("text12")}</h2>
      <p class="cta__text">
        {text("text13")}
      </p>
      <Button href="/tecidos/" variant="primary" size="lg">{text("text14")}</Button>
    </Container>
  </Section>
</BaseLayout>

<style>
  .cards-grid {
    display: grid;
    gap: var(--space-6);
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
  }

  .cross-nav {
    display: grid;
    gap: var(--space-8);
  }

  .cross-nav__eyebrow {
    color: var(--color-accent-soft);
    text-transform: uppercase;
    letter-spacing: 0.2em;
    font-size: 13px;
  }

  .cross-nav__title {
    margin-top: var(--space-3);
    font-size: clamp(24px, 3.5vw, 32px);
  }

  .cross-nav__text {
    margin-top: var(--space-4);
    max-width: 680px;
    color: var(--color-muted);
  }

  .cross-nav__grid {
    display: grid;
    gap: var(--space-6);
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
  }

  .cross-nav__group {
    padding: var(--space-6);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
  }

  .cross-nav__group h3 {
    font-size: 20px;
  }

  .cross-nav__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-4);
  }

  .cta {
    text-align: center;
  }

  .cta__title {
    font-size: clamp(22px, 3.5vw, 32px);
  }

  .cta__text {
    margin-top: var(--space-4);
    color: var(--color-muted);
  }

  .cta :global(.btn) {
    margin-top: var(--space-6);
  }
</style>
