---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Hero from "../../components/ui/Hero.astro";
import Section from "../../components/ui/Section.astro";
import Container from "../../components/ui/Container.astro";
import ProductCard from "../../components/ui/ProductCard.astro";
import Button from "../../components/ui/Button.astro";

const products = [
  {
    title: "KV_001_RYUJIN",
    description: "Identidade oriental, dragão imperial e presença visual forte para ambientes com narrativa marcante.",
    href: "/produtos/kv-001-ryujin/",
  },
  {
    title: "KV_002_MANDALA",
    description: "Arte, mandala e identidade aplicada ao ambiente para projetos que desejam transformação visual.",
    href: "https://kv-002-mandala.netlify.app/",
    target: "_blank",
  },
  {
    title: "KV_020_PURE_BALANCE",
    description: "Clean profissional para clínicas de estética com sensação de tecnologia, limpeza e confiança.",
    href: "/produtos/kv-020-pure-balance/",
  },
  {
    title: "KV_021_NATURAL_BEAUTY",
    description: "Premium neutro para clínicas que unem estética avançada, harmonização e bem-estar.",
    href: "/produtos/kv-021-natural-beauty/",
  },
  {
    title: "KV_022_SOFT_TAUPE",
    description: "Sofisticação discreta para clínicas premium acessíveis com linguagem elegante e equilibrada.",
    href: "/produtos/kv-022-soft-taupe/",
  },
];
---

<BaseLayout
  title="Produtos | KARV"
  description="Poltronas e coleções KARV — área base para produtos e páginas individuais."
>
  <Hero
    eyebrow="Produtos"
    title="Produtos e coleções KARV"
    text="Linhas comerciais desenvolvidas para reforçar o ambiente, ampliar a identidade do projeto e apoiar a comunicação de cada nicho."
  />

  <Section background="surface">
    <Container>
      <div class="cards-grid">
        {products.map((product) => (
          <ProductCard title={product.title} description={product.description} href={product.href} target={product.target} />
        ))}
      </div>
    </Container>
  </Section>

  <Section background="bg">
    <Container>
      <div class="cross-nav">
        <div class="cross-nav__intro">
          <p class="cross-nav__eyebrow">Navegação comercial</p>
          <h2 class="cross-nav__title">Acuradoria por contexto de projeto.</h2>
          <p class="cross-nav__text">
            Use os produtos KARV como ponto de partida e navegue até o nicho ou o tecido que dá estrutura ao ambiente.
          </p>
        </div>

        <div class="cross-nav__grid">
          <div class="cross-nav__group">
            <h3>Por nicho</h3>
            <div class="cross-nav__actions">
              <Button href="/nichos/barbearia/" variant="secondary">Barbearia</Button>
              <Button href="/nichos/clinicas/" variant="secondary">Clínicas</Button>
              <Button href="/nichos/estetica/" variant="secondary">Estética</Button>
            </div>
          </div>

          <div class="cross-nav__group">
            <h3>Por tecido</h3>
            <div class="cross-nav__actions">
              <Button href="/tecidos/premium/" variant="secondary">Premium</Button>
              <Button href="/tecidos/clinicas-esteticas/" variant="secondary">Clínicas</Button>
              <Button href="/tecidos/barbearia/" variant="secondary">Barbearia</Button>
            </div>
          </div>
        </div>
      </div>
    </Container>
  </Section>

  <Section background="bg" spacing="tight">
    <Container size="narrow" class="cta">
      <h2 class="cta__title">Encontre o tecido ideal para a sua poltrona</h2>
      <p class="cta__text">
        Explore a biblioteca de tecidos e revestimentos KARV e combine com a coleção certa para o seu projeto.
      </p>
      <Button href="/tecidos/" variant="primary" size="lg">Ver tecidos</Button>
    </Container>
  </Section>
</BaseLayout>

<style>
  .cards-grid {
    display: grid;
    gap: var(--space-6);
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
  }

  .cross-nav {
    display: grid;
    gap: var(--space-8);
  }

  .cross-nav__eyebrow {
    color: var(--color-accent-soft);
    text-transform: uppercase;
    letter-spacing: 0.2em;
    font-size: 13px;
  }

  .cross-nav__title {
    margin-top: var(--space-3);
    font-size: clamp(24px, 3.5vw, 32px);
  }

  .cross-nav__text {
    margin-top: var(--space-4);
    max-width: 680px;
    color: var(--color-muted);
  }

  .cross-nav__grid {
    display: grid;
    gap: var(--space-6);
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
  }

  .cross-nav__group {
    padding: var(--space-6);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
  }

  .cross-nav__group h3 {
    font-size: 20px;
  }

  .cross-nav__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-4);
  }

  .cta {
    text-align: center;
  }

  .cta__title {
    font-size: clamp(22px, 3.5vw, 32px);
  }

  .cta__text {
    margin-top: var(--space-4);
    color: var(--color-muted);
  }

  .cta :global(.btn) {
    margin-top: var(--space-6);
  }
</style>
