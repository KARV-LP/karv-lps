---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Section from "../../../components/ui/Section.astro";
import Container from "../../../components/ui/Container.astro";
import Button from "../../../components/ui/Button.astro";
import { getPageText } from "../../../utils/i18n";

const text = getPageText(Astro.url.pathname);

const WHATSAPP_NUMBER = "5511945197063";
const WHATSAPP_MESSAGE = text("text61");
const whatsappHref = `https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent(WHATSAPP_MESSAGE)}`;

const IMG = "/images/produtos/kv-001-ryujin";
---

<BaseLayout
>
  <div class="ryujin">
    <section class="ryujin__hero">
      <img
        class="ryujin__hero-img"
        src={`${IMG}/hero-ambiente.jpg`}
        alt={text("text1")}
        loading="eager"
        fetchpriority="high"
        width="1100"
        height="733"
      />
      <div class="ryujin__scrim" aria-hidden="true"></div>
      <div class="ryujin__kmark" aria-hidden="true">
        <div class="ryujin__k">龍神</div>
        <div class="ryujin__r">{text("text11")}</div>
      </div>
      <div class="ryujin__htxt">
        <p class="ryujin__eyebrow ryujin__eyebrow--onink">
          {text("text12")}<span class="ryujin__dot">·</span>{text("text13")}
        </p>
        <h1 class="ryujin__h1">{text("text14")}</h1>
        <p class="ryujin__sub">{text("text15")}</p>
        <div class="ryujin__actions">
          <Button href={whatsappHref} target="_blank" variant="primary" size="lg">
            {text("text16")}
          </Button>
          <a class="ryujin__linkcta ryujin__linkcta--onink" href="#ambientes">{text("text17")}</a>
        </div>
      </div>
    </section>

    <Section id="conceito" spacing="loose">
      <Container>
        <div class="ryujin__split">
          <div class="ryujin__txtcol">
            <p class="ryujin__eyebrow">{text("text18")}<span class="ryujin__dot">·</span>{text("text19")}</p>
            <h2 class="ryujin__disp ryujin__disp--big">
              {text("text20")}<br />{text("text21")}
            </h2>
            <p class="ryujin__lead">
              {text("text22")}
            </p>
          </div>
          <div class="ryujin__imgcol">
            <img
              src={`${IMG}/produto-isolado.jpg`}
              alt={text("text2")}
              loading="lazy"
              decoding="async"
              width="1100"
              height="733"
            />
          </div>
        </div>
      </Container>
    </Section>

    <Section id="arte-aplicada" background="surface" spacing="loose">
      <Container>
        <div class="ryujin__sechead">
          <p class="ryujin__eyebrow">{text("text23")}<span class="ryujin__dot">·</span>{text("text24")}</p>
          <h2 class="ryujin__disp ryujin__disp--mid">{text("text25")}</h2>
        </div>
        <div class="ryujin__grid3">
          <figure>
            <img
              src={`${IMG}/arte-dragao-peonia.jpg`}
              alt={text("text3")}
              loading="lazy"
              decoding="async"
              width="900"
              height="600"
            />
            <figcaption class="ryujin__cap">{text("text26")}</figcaption>
          </figure>
          <figure>
            <img
              src={`${IMG}/arte-costura.jpg`}
              alt={text("text4")}
              loading="lazy"
              decoding="async"
              width="900"
              height="600"
            />
            <figcaption class="ryujin__cap">{text("text27")}</figcaption>
          </figure>
          <figure>
            <img
              src={`${IMG}/arte-vermelho.jpg`}
              alt={text("text5")}
              loading="lazy"
              decoding="async"
              width="900"
              height="600"
            />
            <figcaption class="ryujin__cap">{text("text28")}</figcaption>
          </figure>
        </div>
      </Container>
    </Section>

    <Section id="ambientes" spacing="loose">
      <Container>
        <div class="ryujin__sechead">
          <p class="ryujin__eyebrow">{text("text29")}<span class="ryujin__dot">·</span>{text("text30")}</p>
          <h2 class="ryujin__disp ryujin__disp--mid">
            {text("text31")}
          </h2>
          <p class="ryujin__lead">
            {text("text32")}
          </p>
        </div>
        <div class="ryujin__envs">
          <figure>
            <img
              src={`${IMG}/ambiente-tattoo-studio.jpg`}
              alt={text("text6")}
              loading="lazy"
              decoding="async"
              width="1100"
              height="733"
            />
            <figcaption class="ryujin__cap">{text("text33")}</figcaption>
          </figure>
          <figure>
            <img
              src={`${IMG}/ambiente-barbearia.jpg`}
              alt={text("text7")}
              loading="lazy"
              decoding="async"
              width="1100"
              height="733"
            />
            <figcaption class="ryujin__cap">{text("text34")}</figcaption>
          </figure>
          <figure class="ryujin__envs-third">
            <img
              src={`${IMG}/ambiente-expressivo.jpg`}
              alt={text("text8")}
              loading="lazy"
              decoding="async"
              width="1100"
              height="733"
            />
            <figcaption class="ryujin__cap">{text("text35")}</figcaption>
          </figure>
        </div>
      </Container>
    </Section>

    <Section id="valor" background="surface" spacing="loose" class="ryujin__valor">
      <div class="ryujin__valor-inner">
        <div class="ryujin__valor-img">
          <img
            src={`${IMG}/ambiente-expressivo.jpg`}
            alt={text("text9")}
            loading="lazy"
            decoding="async"
            width="1400"
            height="933"
          />
        </div>
        <div class="ryujin__valor-text">
          <p class="ryujin__eyebrow">{text("text36")}<span class="ryujin__dot">·</span>{text("text37")}</p>
          <h2 class="ryujin__disp ryujin__disp--big">{text("text38")}<br />{text("text39")}</h2>
          <div class="ryujin__metarow">
            <div class="ryujin__meta">
              <div class="ryujin__meta-t">{text("text40")}</div>
              <div class="ryujin__meta-x">
                {text("text41")}
              </div>
            </div>
            <div class="ryujin__meta">
              <div class="ryujin__meta-t">{text("text42")}</div>
              <div class="ryujin__meta-x">
                {text("text43")}
              </div>
            </div>
            <div class="ryujin__meta">
              <div class="ryujin__meta-t">{text("text44")}</div>
              <div class="ryujin__meta-x">
                {text("text45")}
              </div>
            </div>
          </div>
        </div>
      </div>
    </Section>

    <section class="ryujin__cond">
      <Container size="narrow">
        <p class="ryujin__eyebrow ryujin__eyebrow--onink">{text("text46")}<span class="ryujin__dot">·</span>{text("text47")}</p>
        <h2 class="ryujin__disp">{text("text48")}</h2>
        <p class="ryujin__lead ryujin__lead--onink">
          {text("text49")}
        </p>
      </Container>
    </section>

    <section class="ryujin__cta">
      <div class="ryujin__k ryujin__k--cta" aria-hidden="true">龍神</div>
      <h2 class="ryujin__disp">{text("text50")}<br />{text("text51")}</h2>
      <div class="ryujin__actions ryujin__actions--center">
        <Button href={whatsappHref} target="_blank" variant="primary" size="lg">
          {text("text52")}
        </Button>
        <a class="ryujin__linkcta ryujin__linkcta--onink" href={whatsappHref} target="_blank" rel="noopener noreferrer">
          {text("text53")}
        </a>
      </div>
    </section>

    <section class="ryujin__closer">
      <img
        src={`${IMG}/ambiente-tattoo-studio.jpg`}
        alt={text("text10")}
        loading="lazy"
        decoding="async"
        width="1600"
        height="1067"
      />
    </section>

    <footer class="ryujin__foot">
      <Container>
        <div class="ryujin__foot-inner">
          <div>
            <p class="ryujin__wm">{text("text54")}<b>·</b>{text("text55")}</p>
            <p class="ryujin__tag">{text("text56")}</p>
          </div>
          <div class="ryujin__foot-cols">
            <div>
              <p class="ryujin__foot-h">{text("text57")}</p>
              <a class="ryujin__foot-whatsapp" href={whatsappHref} target="_blank" rel="noopener noreferrer">
                {text("text58")}
              </a>
              <span>{text("text59")}</span>
            </div>
            <div>
              <p class="ryujin__foot-h">{text("text60")}</p>
              <a href="https://www.instagram.com/karv.dna/" target="_blank" rel="noopener noreferrer">
                Instagram · @karv.dna
              </a>
            </div>
          </div>
        </div>
      </Container>
    </footer>
  </div>
</BaseLayout>

<style>
  .ryujin {
    --ink: #15120e;
    --bg: #f3eee6;
    --sand: #e7decf;
    --line: #d8cfbe;
    --bronze: #96774b;
    --bronze2: #b79a6b;
    --stone: #6c6357;
    --serif: "Iowan Old Style", "Palatino Linotype", "Palatino", "Georgia", serif;
    --mincho: "Hiragino Mincho ProN", "Yu Mincho", "Songti SC", "MS Mincho", serif;

    --color-bg: var(--bg);
    --color-surface: var(--sand);
    --color-surface-soft: var(--ink);
    --color-text: var(--ink);
    --color-muted: var(--stone);
    --color-accent: var(--bronze);
    --color-accent-soft: var(--bronze2);
    --color-border: var(--line);

    background: var(--bg);
    color: var(--ink);
  }

  .ryujin :global(.section) {
    padding-block: 64px;
  }

  @media (min-width: 900px) {
    .ryujin :global(.section) {
      padding-block: 150px;
    }
  }

  /* ---------- shared type ---------- */
  .ryujin__eyebrow {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--bronze);
  }

  .ryujin__eyebrow--onink {
    color: var(--bronze2);
  }

  .ryujin__dot {
    color: var(--bronze);
    margin: 0 0.5em;
  }

  .ryujin__disp {
    font-family: var(--serif);
    color: var(--ink);
    font-weight: 500;
    line-height: 1.06;
    letter-spacing: -0.01em;
    font-size: 30px;
    margin-top: 16px;
  }

  .ryujin__disp--big {
    font-size: 30px;
  }

  .ryujin__disp--mid {
    font-size: 26px;
  }

  @media (min-width: 900px) {
    .ryujin__disp--big {
      font-size: 50px;
    }
    .ryujin__disp--mid {
      font-size: 40px;
    }
  }

  .ryujin__lead {
    margin-top: 18px;
    font-size: 15px;
    line-height: 1.72;
    color: var(--stone);
    max-width: 52ch;
  }

  .ryujin__lead--onink {
    color: #c9bfae;
    margin-inline: auto;
  }

  @media (min-width: 900px) {
    .ryujin__lead {
      margin-top: 26px;
      font-size: 18px;
    }
  }

  .ryujin__cap {
    margin-top: 10px;
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #8a8072;
  }

  @media (min-width: 900px) {
    .ryujin__cap {
      margin-top: 14px;
    }
  }

  .ryujin__linkcta {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink);
    text-decoration: none;
    border-bottom: 1px solid var(--bronze);
    padding-bottom: 4px;
  }

  .ryujin__linkcta--onink {
    color: #ede4d5;
  }

  .ryujin__actions {
    margin-top: 26px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 18px;
  }

  .ryujin__actions--center {
    align-items: center;
  }

  @media (min-width: 900px) {
    .ryujin__actions {
      flex-direction: row;
      align-items: center;
      gap: 26px;
      margin-top: 36px;
    }
  }

  /* ---------- hero ---------- */
  .ryujin__hero {
    position: relative;
    height: 600px;
    background: #000;
  }

  @media (min-width: 900px) {
    .ryujin__hero {
      height: 760px;
    }
  }

  .ryujin__hero-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 42%;
    display: block;
  }

  @media (min-width: 900px) {
    .ryujin__hero-img {
      object-position: center 40%;
    }
  }

  .ryujin__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(0deg, rgba(10, 8, 6, 0.78), rgba(10, 8, 6, 0.05) 60%);
  }

  @media (min-width: 900px) {
    .ryujin__scrim {
      background:
        linear-gradient(90deg, rgba(10, 8, 6, 0.72) 0%, rgba(10, 8, 6, 0.3) 42%, rgba(10, 8, 6, 0) 68%),
        linear-gradient(0deg, rgba(10, 8, 6, 0.55), rgba(10, 8, 6, 0) 55%);
    }
  }

  .ryujin__kmark {
    position: absolute;
    right: 24px;
    top: 26px;
    text-align: right;
  }

  .ryujin__kmark .ryujin__k {
    font-family: var(--mincho);
    font-size: 34px;
    color: rgba(246, 241, 232, 0.9);
    line-height: 1;
  }

  .ryujin__kmark .ryujin__r {
    display: none;
  }

  @media (min-width: 900px) {
    .ryujin__kmark {
      right: 120px;
      top: 64px;
    }
    .ryujin__kmark .ryujin__k {
      font-size: 56px;
    }
    .ryujin__kmark .ryujin__r {
      display: block;
      margin-top: 10px;
      font-size: 11px;
      letter-spacing: 0.32em;
      color: rgba(246, 241, 232, 0.7);
      text-transform: uppercase;
    }
  }

  .ryujin__htxt {
    position: absolute;
    left: 24px;
    right: 24px;
    bottom: 40px;
  }

  @media (min-width: 900px) {
    .ryujin__htxt {
      left: 120px;
      right: auto;
      bottom: 96px;
      max-width: 620px;
    }
  }

  .ryujin__h1 {
    font-family: var(--serif);
    color: #f6f1e8;
    font-weight: 500;
    font-size: 56px;
    line-height: 0.94;
    margin: 14px 0 0;
  }

  @media (min-width: 900px) {
    .ryujin__h1 {
      font-size: 104px;
      line-height: 0.92;
      letter-spacing: -0.02em;
    }
  }

  .ryujin__sub {
    font-family: var(--serif);
    font-style: italic;
    color: #eae1d2;
    font-size: 17px;
    line-height: 1.4;
    margin-top: 16px;
  }

  @media (min-width: 900px) {
    .ryujin__sub {
      font-size: 23px;
      margin-top: 22px;
      max-width: 440px;
    }
  }

  /* ---------- split (conceito) ---------- */
  .ryujin__split {
    display: grid;
    grid-template-columns: 1fr;
    gap: 32px;
    align-items: center;
  }

  @media (min-width: 900px) {
    .ryujin__split {
      grid-template-columns: 1fr 1fr;
      gap: 96px;
    }
  }

  .ryujin__imgcol img {
    width: 100%;
    height: 300px;
    object-fit: cover;
    display: block;
  }

  @media (min-width: 900px) {
    .ryujin__imgcol img {
      height: 560px;
    }
  }

  /* ---------- sechead / grids ---------- */
  .ryujin__sechead {
    max-width: 1200px;
  }

  .ryujin__grid3 {
    margin-top: 26px;
    display: grid;
    grid-template-columns: 1fr;
    gap: 14px;
  }

  @media (min-width: 900px) {
    .ryujin__grid3 {
      margin-top: 56px;
      grid-template-columns: repeat(3, 1fr);
      gap: 28px;
    }
  }

  .ryujin__grid3 img {
    width: 100%;
    height: 300px;
    object-fit: cover;
    display: block;
  }

  @media (min-width: 900px) {
    .ryujin__grid3 img {
      height: 360px;
    }
  }

  .ryujin__envs {
    margin-top: 26px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  @media (min-width: 900px) {
    .ryujin__envs {
      margin-top: 60px;
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 24px;
    }
  }

  .ryujin__envs img {
    width: 100%;
    height: 300px;
    object-fit: cover;
    display: block;
  }

  @media (min-width: 900px) {
    .ryujin__envs img {
      height: 440px;
    }
  }

  .ryujin__envs-third {
    display: none;
  }

  @media (min-width: 900px) {
    .ryujin__envs-third {
      display: block;
    }
  }

  /* ---------- valor ---------- */
  .ryujin :global(.ryujin__valor) {
    padding: 0 !important;
  }

  .ryujin__valor-inner {
    display: flex;
    flex-direction: column;
  }

  @media (min-width: 900px) {
    .ryujin__valor-inner {
      flex-direction: row;
      align-items: stretch;
    }
  }

  .ryujin__valor-img {
    flex: 1 1 55%;
  }

  .ryujin__valor-img img {
    width: 100%;
    height: 260px;
    object-fit: cover;
    display: block;
  }

  @media (min-width: 900px) {
    .ryujin__valor-img img {
      height: 100%;
      min-height: 560px;
    }
  }

  .ryujin__valor-text {
    flex: 1 1 45%;
    padding: 64px 24px;
  }

  @media (min-width: 900px) {
    .ryujin__valor-text {
      padding: 96px 120px 96px 0;
      display: flex;
      flex-direction: column;
      justify-content: center;
    }
  }

  .ryujin__metarow {
    margin-top: 26px;
    display: flex;
    flex-direction: column;
    gap: 22px;
  }

  @media (min-width: 900px) {
    .ryujin__metarow {
      margin-top: 40px;
      flex-direction: row;
      flex-wrap: wrap;
      gap: 40px;
    }
  }

  .ryujin__meta {
    max-width: 230px;
  }

  .ryujin__meta-t {
    font-family: var(--serif);
    font-size: 17px;
    color: var(--ink);
    margin-bottom: 6px;
  }

  @media (min-width: 900px) {
    .ryujin__meta-t {
      font-size: 19px;
      margin-bottom: 8px;
    }
  }

  .ryujin__meta-x {
    font-size: 14px;
    color: var(--stone);
    line-height: 1.6;
  }

  /* ---------- condições ---------- */
  .ryujin__cond {
    background: var(--ink);
    color: #ede4d5;
    padding: 64px 24px;
    text-align: center;
  }

  @media (min-width: 900px) {
    .ryujin__cond {
      padding: 150px 120px;
    }
  }

  .ryujin__cond .ryujin__disp {
    color: #f5eee1;
    font-size: 27px;
  }

  @media (min-width: 900px) {
    .ryujin__cond .ryujin__disp {
      font-size: 44px;
    }
  }

  .ryujin__cond .ryujin__lead {
    margin-inline: auto;
  }

  /* ---------- cta ---------- */
  .ryujin__cta {
    background: #1e1a15;
    padding: 72px 24px;
    text-align: center;
    border-top: 1px solid rgba(183, 154, 107, 0.28);
  }

  @media (min-width: 900px) {
    .ryujin__cta {
      padding: 170px 120px;
    }
  }

  .ryujin__k--cta {
    font-family: var(--mincho);
    color: var(--bronze2);
    font-size: 30px;
  }

  @media (min-width: 900px) {
    .ryujin__k--cta {
      font-size: 40px;
    }
  }

  .ryujin__cta .ryujin__disp {
    color: #f6f1e8;
    font-size: 34px;
  }

  @media (min-width: 900px) {
    .ryujin__cta .ryujin__disp {
      font-size: 58px;
    }
  }

  /* ---------- closer / footer ---------- */
  .ryujin__closer img {
    width: 100%;
    height: 360px;
    object-fit: cover;
    display: block;
  }

  @media (min-width: 900px) {
    .ryujin__closer img {
      height: 560px;
    }
  }

  .ryujin__foot {
    background: var(--ink);
    color: #b7ac9b;
    padding-block: 48px 56px;
  }

  @media (min-width: 900px) {
    .ryujin__foot {
      padding: 80px 0 90px;
    }
  }

  .ryujin__foot-inner {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  @media (min-width: 900px) {
    .ryujin__foot-inner {
      flex-direction: row;
      justify-content: space-between;
      align-items: flex-end;
      gap: 40px;
    }
  }

  .ryujin__wm {
    font-family: var(--serif);
    font-size: 30px;
    color: #f1e9da;
    margin: 0;
  }

  @media (min-width: 900px) {
    .ryujin__wm {
      font-size: 40px;
      letter-spacing: 0.04em;
    }
  }

  .ryujin__wm b {
    color: var(--bronze2);
    font-weight: 500;
  }

  .ryujin__tag {
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #8a8072;
    margin-top: 10px;
  }

  @media (min-width: 900px) {
    .ryujin__tag {
      font-size: 12px;
      margin-top: 12px;
    }
  }

  .ryujin__foot-cols {
    display: flex;
    gap: 48px;
  }

  @media (min-width: 900px) {
    .ryujin__foot-cols {
      gap: 64px;
      text-align: right;
    }
  }

  .ryujin__foot-h {
