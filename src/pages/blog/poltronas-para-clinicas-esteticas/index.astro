---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Hero from "../../../components/ui/Hero.astro";
import Section from "../../../components/ui/Section.astro";
import Container from "../../../components/ui/Container.astro";
import ProductCard from "../../../components/ui/ProductCard.astro";
import Button from "../../../components/ui/Button.astro";
import { getPageText } from "../../../utils/i18n";

const text = getPageText(Astro.url.pathname);
---

<BaseLayout
>
  <Hero
    eyebrow={text("text17")}
    title={text("text1")}
    text={text("text18")}
  />

  <Section background="surface">
    <Container size="narrow">
      <p>
        {text("text4")}
      </p>

      <h2>{text("text5")}</h2>
      <p>
        {text("text6")}
      </p>

      <h2>{text("text7")}</h2>
      <p>
        {text("text8")}
      </p>

      <h2>{text("text9")}</h2>
      <ul>
        <li>{text("text10")}</li>
        <li>{text("text11")}</li>
        <li>{text("text12")}</li>
        <li>{text("text13")}</li>
      </ul>
    </Container>
  </Section>

  <Section background="bg">
    <Container>
      <div class="cards-grid">
        <ProductCard
          title={text("text21")}
          description={text("text22")}
          href="/produtos/"
        />
        <ProductCard
          title={text("text2")}
          description={text("text19")}
          href="/tecidos/"
        />
        <ProductCard
          title={text("text3")}
          description={text("text20")}
          href="/nichos/"
        />
      </div>
    </Container>
  </Section>

  <Section background="surface" spacing="tight">
    <Container size="narrow" class="cta">
      <h2>{text("text14")}</h2>
      <p>
        {text("text15")}
      </p>
      <Button href="/produtos/" variant="primary" size="lg">{text("text16")}</Button>
    </Container>
  </Section>
</BaseLayout>

<style>
  .cards-grid {
    display: grid;
    gap: var(--space-6);
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  }

  .cta {
    text-align: center;
  }

  .cta :global(.btn) {
    margin-top: var(--space-6);
  }
</style>
