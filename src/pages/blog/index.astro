---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Hero from "../../components/ui/Hero.astro";
import Section from "../../components/ui/Section.astro";
import Container from "../../components/ui/Container.astro";
import ProductCard from "../../components/ui/ProductCard.astro";
import Button from "../../components/ui/Button.astro";
import { getPageText } from "../../utils/i18n";

const text = getPageText(Astro.url.pathname);

const articles = [
  {
    title: text("text10"),
    description: text("text11"),
    href: "/blog/mobiliario-de-identidade/",
  },
  {
    title: text("text12"),
    description: text("text13"),
    href: "/blog/poltronas-personalizadas-para-negocios/",
  },
  {
    title: text("text14"),
    description: text("text15"),
    href: "/blog/como-escolher-tecido-para-poltrona-comercial/",
  },
  {
    title: text("text16"),
    description: text("text17"),
    href: "/blog/poltronas-para-clinicas-esteticas/",
  },
  {
    title: text("text18"),
    description: text("text19"),
    href: "/blog/poltronas-para-barbearias/",
  },
];
---

<BaseLayout
>
  <Hero
    eyebrow={text("text21")}
    title={text("text2")}
    text={text("text22")}
    primaryCta={{ label: text("text23"), href: "/produtos/" }}
    secondaryCta={{ label: text("text24"), href: "/nichos/" }}
  />

  <Section background="surface">
    <Container>
      <div class="section-intro">
        <p class="section-intro__eyebrow">{text("text3")}</p>
        <h2 class="section-intro__title">{text("text4")}</h2>
        <p class="section-intro__text">
          {text("text5")}
        </p>
      </div>

      <div class="cards-grid">
        {articles.map((article) => (
          <ProductCard title={article.title} description={article.description} href={article.href} />
        ))}
      </div>
    </Container>
  </Section>

  <Section background="bg" spacing="tight">
    <Container size="narrow" class="cta">
      <h2 class="cta__title">{text("text6")}</h2>
      <p class="cta__text">
        {text("text7")}
      </p>
      <div class="cta__actions">
        <Button href="/produtos/" variant="primary">{text("text8")}</Button>
        <Button href="/tecidos/" variant="secondary">{text("text9")}</Button>
      </div>
    </Container>
  </Section>
</BaseLayout>

<style>
  .section-intro {
    max-width: 760px;
    margin-bottom: var(--space-8);
  }

  .section-intro__eyebrow {
    color: var(--color-accent-soft);
    text-transform: uppercase;
    letter-spacing: 0.2em;
    font-size: 13px;
    margin-bottom: var(--space-3);
  }

  .section-intro__title {
    font-size: clamp(28px, 4vw, 40px);
  }

  .section-intro__text {
    margin-top: var(--space-4);
    color: var(--color-muted);
    font-size: 18px;
  }

  .cards-grid {
    display: grid;
    gap: var(--space-6);
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  }

  .cta {
    text-align: center;
  }

  .cta__title {
    font-size: clamp(22px, 3.5vw, 32px);
  }

  .cta__text {
    margin-top: var(--space-4);
    color: var(--color-muted);
  }

  .cta__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-3);
    margin-top: var(--space-6);
  }
</style>
