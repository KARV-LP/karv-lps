---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Hero from "../../../components/ui/Hero.astro";
import Section from "../../../components/ui/Section.astro";
import Container from "../../../components/ui/Container.astro";
import Button from "../../../components/ui/Button.astro";
import ProductCard from "../../../components/ui/ProductCard.astro";
import { getPageText } from "../../../utils/i18n";

const text = getPageText(Astro.url.pathname);

const pillars = [
  {
    title: text("text19"),
    text: text("text11"),
  },
  {
    title: text("text20"),
    text: text("text12"),
  },
  {
    title: text("text13"),
    text: text("text14"),
  },
];
---

<BaseLayout
>
  <Hero
    eyebrow={text("text15")}
    title={text("text1")}
    text={text("text16")}
    primaryCta={{ label: text("text17"), href: "/tecidos/" }}
    secondaryCta={{ label: "Ver premium", href: "/tecidos/premium/" }}
  />

  <Section background="surface">
    <Container>
      <div class="intro">
        <p class="intro__eyebrow">{text("text2")}</p>
        <h2 class="intro__title">{text("text3")}</h2>
        <p class="intro__text">
          {text("text4")}
        </p>
      </div>

      <div class="cards-grid">
        {pillars.map((item) => (
          <article class="info-card">
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </article>
        ))}
      </div>
    </Container>
  </Section>

  <Section background="bg">
    <Container>
      <div class="cross-nav">
        <div class="cross-nav__intro">
          <p class="cross-nav__eyebrow">{text("text5")}</p>
          <h2 class="cross-nav__title">{text("text6")}</h2>
          <p class="cross-nav__text">
            {text("text7")}
          </p>
        </div>

        <div class="cross-nav__grid">
          <ProductCard
            title={text("text21")}
            description={text("text18")}
            href="/tecidos/"
          />
          <ProductCard
            title={text("text22")}
            description={text("text24")}
            href="/produtos/"
          />
          <ProductCard
            title={text("text25")}
            description={text("text26")}
            href="/nichos/"
          />
        </div>
      </div>
    </Container>
  </Section>

  <Section background="surface-soft" spacing="tight">
    <Container size="narrow" class="cta">
      <h2 class="cta__title">{text("text8")}</h2>
      <p class="cta__text">
        {text("text9")}
      </p>
      <Button href="/tecidos/" variant="primary" size="lg">{text("text10")}</Button>
    </Container>
  </Section>
</BaseLayout>

<style>
  .intro {
    max-width: 760px;
    margin-bottom: var(--space-8);
  }

  .intro__eyebrow {
    color: var(--color-accent-soft);
    text-transform: uppercase;
    letter-spacing: 0.2em;
    font-size: 13px;
    margin-bottom: var(--space-3);
  }

  .intro__title {
    font-size: clamp(28px, 4vw, 40px);
  }

  .intro__text {
    margin-top: var(--space-4);
    color: var(--color-muted);
    font-size: 18px;
  }

  .cards-grid {
    display: grid;
    gap: var(--space-6);
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  }

  .info-card {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    background: var(--color-bg);
  }

  .info-card h3 {
    font-size: 20px;
    margin-bottom: var(--space-3);
  }

  .info-card p {
    color: var(--color-muted);
  }

  .cross-nav {
    display: grid;
    gap: var(--space-8);
  }

  .cross-nav__eyebrow {
    color: var(--color-accent-soft);
    text-transform: uppercase;
    letter-spacing: 0.2em;
    font-size: 13px;
  }

  .cross-nav__title {
    margin-top: var(--space-3);
    font-size: clamp(24px, 3.5vw, 32px);
  }

  .cross-nav__text {
    margin-top: var(--space-4);
    max-width: 720px;
    color: var(--color-muted);
  }

  .cross-nav__grid {
    display: grid;
    gap: var(--space-6);
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  }

  .cta {
    text-align: center;
  }

  .cta__title {
    font-size: clamp(22px, 3.5vw, 32px);
  }

  .cta__text {
    margin-top: var(--space-4);
    color: var(--color-muted);
  }

  .cta :global(.btn) {
    margin-top: var(--space-6);
  }
</style>
