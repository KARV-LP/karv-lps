---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Hero from "../../components/ui/Hero.astro";
import Section from "../../components/ui/Section.astro";
import Container from "../../components/ui/Container.astro";
import ProductCard from "../../components/ui/ProductCard.astro";
import Button from "../../components/ui/Button.astro";
import { getPageText } from "../../utils/i18n";

const text = getPageText(Astro.url.pathname);

const categories = [
  {
    title: text("text13"),
    description: text("text14"),
    href: "/tecidos/premium/",
  },
  {
    title: text("text15"),
    description: text("text16"),
    href: "/tecidos/clinicas-esteticas/",
  },
  {
    title: text("text17"),
    description: text("text18"),
    href: "/tecidos/barbearia/",
  },
  {
    title: text("text19"),
    description: text("text20"),
    href: "/tecidos/pet-friendly/",
  },
  {
    title: text("text21"),
    description: text("text22"),
    href: "/tecidos/colecoes/",
  },
];
---

<BaseLayout
>
  <Hero
    eyebrow={text("text24")}
    title={text("text1")}
    text={text("text25")}
    primaryCta={{ label: text("text26"), href: "/tecidos/colecoes/" }}
    secondaryCta={{ label: text("text8"), href: "/produtos/" }}
  />

  <Section background="surface">
    <Container>
      <div class="section-intro">
        <p class="section-intro__eyebrow">{text("text2")}</p>
        <h2 class="section-intro__title">{text("text3")}</h2>
        <p class="section-intro__text">
          {text("text4")}
        </p>
      </div>

      <div class="cards-grid">
        {categories.map((category) => (
          <ProductCard title={category.title} description={category.description} href={category.href} />
        ))}
      </div>
    </Container>
  </Section>

  <Section background="bg">
    <Container>
      <div class="cross-nav">
        <div class="cross-nav__intro">
          <p class="cross-nav__eyebrow">{text("text5")}</p>
          <h2 class="cross-nav__title">{text("text6")}</h2>
          <p class="cross-nav__text">
            {text("text7")}
          </p>
        </div>

        <div class="cross-nav__actions">
          <Button href="/produtos/" variant="primary">{text("text8")}</Button>
          <Button href="/nichos/" variant="secondary">{text("text9")}</Button>
          <Button href="/tecidos/colecoes/" variant="secondary">{text("text10")}</Button>
        </div>
      </div>
    </Container>
  </Section>

  <Section background="bg" spacing="tight">
    <Container size="narrow" class="cta">
      <h2 class="cta__title">{text("text11")}</h2>
      <p class="cta__text">
        {text("text12")}
      </p>
      <Button href="/produtos/" variant="primary" size="lg">{text("text8")}</Button>
    </Container>
  </Section>
</BaseLayout>

<style>
  .section-intro {
    max-width: 760px;
    margin-bottom: var(--space-8);
  }

  .section-intro__eyebrow {
    color: var(--color-accent-soft);
    text-transform: uppercase;
    letter-spacing: 0.2em;
    font-size: 13px;
    margin-bottom: var(--space-3);
  }

  .section-intro__title {
    font-size: clamp(28px, 4vw, 40px);
  }

  .section-intro__text {
    margin-top: var(--space-4);
    color: var(--color-muted);
    font-size: 18px;
  }

  .cards-grid {
    display: grid;
    gap: var(--space-6);
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  }

  .cross-nav {
    display: grid;
    gap: var(--space-6);
  }

  .cross-nav__eyebrow {
    color: var(--color-accent-soft);
    text-transform: uppercase;
    letter-spacing: 0.2em;
    font-size: 13px;
  }

  .cross-nav__title {
    margin-top: var(--space-3);
    font-size: clamp(24px, 3.5vw, 32px);
  }

  .cross-nav__text {
    margin-top: var(--space-4);
    max-width: 720px;
    color: var(--color-muted);
  }

  .cross-nav__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .cta {
    text-align: center;
  }

  .cta__title {
    font-size: clamp(22px, 3.5vw, 32px);
  }

  .cta__text {
    margin-top: var(--space-4);
    color: var(--color-muted);
  }

  .cta :global(.btn) {
    margin-top: var(--space-6);
  }
</style>
