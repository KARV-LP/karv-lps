---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Hero from "../../../components/ui/Hero.astro";
import Section from "../../../components/ui/Section.astro";
import Container from "../../../components/ui/Container.astro";
import Button from "../../../components/ui/Button.astro";
import { getPageText } from "../../../utils/i18n";

const text = getPageText(Astro.url.pathname);

const highlights = [
  {
    title: text("text21"),
    text: text("text9"),
  },
  {
    title: text("text25"),
    text: text("text10"),
  },
  {
    title: text("text11"),
    text: text("text12"),
  },
];

const applications = [
  text("text13"),
  text("text14"),
  text("text15"),
];

const benefits = [
  text("text16"),
  text("text22"),
  text("text17"),
];
---

<BaseLayout
>
  <Hero
    eyebrow={text("text18")}
    title={text("text23")}
    text={text("text19")}
    primaryCta={{ label: text("text8"), href: "/tecidos/" }}
    secondaryCta={{ label: text("text20"), href: "/tecidos/colecoes/" }}
  />

  <Section background="surface">
    <Container>
      <div class="intro">
        <p class="intro__eyebrow">{text("text1")}</p>
        <h2 class="intro__title">{text("text2")}</h2>
        <p class="intro__text">
          {text("text3")}
        </p>
      </div>

      <div class="cards-grid">
        {highlights.map((item) => (
          <article class="info-card">
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </article>
        ))}
      </div>
    </Container>
  </Section>

  <Section background="bg">
    <Container class="split">
      <div class="content-block">
        <h2>{text("text4")}</h2>
        <ul class="feature-list">
          {applications.map((item) => <li>{item}</li>)}
        </ul>
      </div>
      <div class="content-block">
        <h2>{text("text5")}</h2>
        <ul class="feature-list">
          {benefits.map((item) => <li>{item}</li>)}
        </ul>
      </div>
    </Container>
  </Section>

  <Section background="surface-soft" spacing="tight">
    <Container size="narrow" class="cta">
      <h2 class="cta__title">{text("text6")}</h2>
      <p class="cta__text">
        {text("text7")}
      </p>
      <Button href="/tecidos/" variant="primary" size="lg">{text("text8")}</Button>
    </Container>
  </Section>
</BaseLayout>

<style>
  .intro {
    max-width: 760px;
    margin-bottom: var(--space-8);
  }

  .intro__eyebrow {
    color: var(--color-accent-soft);
    text-transform: uppercase;
    letter-spacing: 0.2em;
    font-size: 13px;
    margin-bottom: var(--space-3);
  }

  .intro__title {
    font-size: clamp(28px, 4vw, 40px);
  }

  .intro__text {
    margin-top: var(--space-4);
    color: var(--color-muted);
    font-size: 18px;
  }

  .cards-grid {
    display: grid;
    gap: var(--space-6);
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  }

  .info-card {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    background: var(--color-bg);
  }

  .info-card h3 {
    font-size: 20px;
    margin-bottom: var(--space-3);
  }

  .info-card p {
    color: var(--color-muted);
  }

  .split {
    display: grid;
    gap: var(--space-8);
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  }

  .content-block {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    background: var(--color-surface);
  }

  .content-block h2 {
    font-size: 22px;
    margin-bottom: var(--space-4);
  }

  .feature-list {
    display: grid;
    gap: var(--space-3);
    color: var(--color-muted);
  }

  .feature-list li {
    padding-left: var(--space-4);
    position: relative;
  }

  .feature-list li::before {
    content: "•";
    color: var(--color-accent-soft);
    position: absolute;
    left: 0;
  }

  .cta {
    text-align: center;
  }

  .cta__title {
    font-size: clamp(22px, 3.5vw, 32px);
  }

  .cta__text {
    margin-top: var(--space-4);
    color: var(--color-muted);
  }

  .cta :global(.btn) {
    margin-top: var(--space-6);
  }
</style>
