---
import { localizedPath, t, type Locale } from "../../utils/i18n";

interface Props {
  locale: Locale;
  path: string;
}

const { locale, path } = Astro.props;
const navigation = t(locale, "navigation");
const navItems = [
  { slug: "", label: navigation.home },
  { slug: "produtos", label: navigation.products },
  { slug: "nichos", label: navigation.niches },
  { slug: "tecidos", label: navigation.fabrics },
  { slug: "blog", label: navigation.content }
];
const currentPath = localizedPath(locale, path);
---

<header class="site-header sticky top-0 z-50 border-b border-karv-border bg-karv-ink-overlay backdrop-blur-[10px]">
  <div class="site-header__inner mx-auto flex max-w-karv items-center justify-between gap-karv-4 p-karv-4">
    <a href={localizedPath(locale)} class="site-header__logo font-karv-display text-karv-xl font-bold tracking-[0.08em] text-karv-paper">
      KARV
    </a>
    <nav class="site-header__nav flex min-w-0 flex-wrap gap-x-karv-6 gap-y-karv-2" aria-label={navigation.primary}>
      {navItems.map((item) => (
        <a
          href={localizedPath(locale, item.slug)}
          class:list={[
            "site-header__link border-b py-karv-2 font-karv-text text-karv-sm transition-[color,border-color] duration-[var(--duration-fast)] ease-[var(--easing-standard)]",
            { "is-active": currentPath === localizedPath(locale, item.slug) },
          ]}
          aria-current={currentPath === localizedPath(locale, item.slug) ? "page" : undefined}
        >
          {item.label}
        </a>
      ))}
    </nav>
    <nav class="site-header__languages flex flex-none items-center gap-karv-1 rounded-karv-pill border border-karv-border p-[2px]" aria-label={navigation.languageSwitcher}>
      {(["pt", "en"] as const).map((language) => (
        <a
          href={localizedPath(language, path)}
          class="site-header__language rounded-karv-pill px-[7px] py-[5px] font-karv-text text-karv-xs font-bold tracking-[0.08em]"
          lang={language === "pt" ? "pt-BR" : "en"}
          hreflang={language === "pt" ? "pt-BR" : "en"}
          aria-label={language === "pt" ? "Português do Brasil" : "English"}
          aria-current={language === locale ? "page" : undefined}
        >
          {language.toUpperCase()}
        </a>
      ))}
    </nav>
  </div>
</header>

<style>
  .site-header__link {
    color: var(--color-muted);
    border-color: transparent;
  }

  .site-header__link:hover,
  .site-header__link.is-active {
    color: var(--color-accent-soft);
    border-color: var(--color-accent);
  }

  .site-header__language {
    color: var(--color-muted);
  }

  .site-header__language[aria-current="page"] {
    background: var(--color-accent);
    color: var(--color-bg);
  }

  .site-header__language:not([aria-current="page"]):hover {
    color: var(--color-accent-soft);
  }

  @media (max-width: 640px) {
    .site-header__inner {
      flex-direction: column;
      align-items: flex-start;
    }

    .site-header__nav {
      width: 100%;
      overflow-x: auto;
      padding-bottom: var(--space-1);
    }

    .site-header__languages {
      align-self: flex-end;
      margin-top: calc(-1 * var(--space-10));
    }
  }
</style>
