---
import { localizedPath, t, type Locale } from "../../utils/i18n";

interface Props {
  locale: Locale;
  path: string;
}

const { locale, path } = Astro.props;
const navigation = t(locale, "navigation");
const navItems = [
  { slug: "", label: navigation.home },
  { slug: "produtos", label: navigation.products },
  { slug: "nichos", label: navigation.niches },
  { slug: "tecidos", label: navigation.fabrics },
  { slug: "blog", label: navigation.content }
];
const currentPath = localizedPath(locale, path);
---

<header class="site-header">
  <div class="site-header__inner">
    <a href={localizedPath(locale)} class="site-header__logo">KARV</a>
    <nav class="site-header__nav" aria-label={navigation.primary}>
      {navItems.map((item) => (
        <a
          href={localizedPath(locale, item.slug)}
          class:list={["site-header__link", { "is-active": currentPath === localizedPath(locale, item.slug) }]}
        >
          {item.label}
        </a>
      ))}
    </nav>
    <nav class="site-header__languages" aria-label={navigation.languageSwitcher}>
      {(["pt", "en"] as const).map((language) => (
        <a
          href={localizedPath(language, path)}
          lang={language === "pt" ? "pt-BR" : "en"}
          hreflang={language === "pt" ? "pt-BR" : "en"}
          aria-current={language === locale ? "page" : undefined}
        >
          {language.toUpperCase()}
        </a>
      ))}
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(14, 14, 14, 0.85);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--color-border);
  }

  .site-header__inner {
    max-width: var(--container-width);
    margin-inline: auto;
    padding: var(--space-4);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .site-header__logo {
    font-size: 20px;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--color-text);
  }

  .site-header__nav {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-6);
    min-width: 0;
  }

  .site-header__link {
    font-size: 14px;
    color: var(--color-muted);
    padding: var(--space-2) 0;
    border-bottom: 1px solid transparent;
    transition:
      color var(--transition-base),
      border-color var(--transition-base);
  }

  .site-header__link:hover,
  .site-header__link.is-active {
    color: var(--color-accent-soft);
    border-color: var(--color-accent);
  }

  .site-header__languages {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    padding: 2px;
    flex: 0 0 auto;
  }

  .site-header__languages a {
    border-radius: var(--radius-pill);
    color: var(--color-muted);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.08em;
    padding: 5px 7px;
  }

  .site-header__languages a[aria-current="page"] {
    background: var(--color-accent);
    color: var(--color-bg);
  }

  .site-header__languages a:not([aria-current="page"]):hover {
    color: var(--color-accent-soft);
  }

  @media (max-width: 640px) {
    .site-header__inner {
      flex-direction: column;
      align-items: flex-start;
    }

    .site-header__nav {
      width: 100%;
      overflow-x: auto;
      padding-bottom: var(--space-1);
    }

    .site-header__languages {
      align-self: flex-end;
      margin-top: calc(-1 * var(--space-10));
    }
  }
</style>
