---
import Section from "./Section.astro";
import Container from "./Container.astro";
import Button from "./Button.astro";

interface CTA {
  label: string;
  href: string;
  target?: string;
  event?: string;
  location?: string;
}

interface Props {
  eyebrow?: string;
  title: string;
  text?: string;
  primaryCta?: CTA;
  secondaryCta?: CTA;
}

const { eyebrow, title, text, primaryCta, secondaryCta } = Astro.props;
---

<Section background="bg" spacing="loose" class="hero relative isolate overflow-hidden">
  <Container class="hero__content relative z-10">
    {eyebrow && (
      <p class="hero__eyebrow mb-karv-4 font-karv-text text-karv-xs uppercase tracking-[0.22em] text-karv-glow">
        {eyebrow}
      </p>
    )}
    <h1 class="hero__title font-karv-display text-karv-hero leading-karv-tight tracking-karv-tight">{title}</h1>
    {text && <p class="hero__text mt-karv-6 max-w-[60ch] text-karv-lg text-karv-greige">{text}</p>}
    {(primaryCta || secondaryCta) && (
      <div class="hero__actions mt-karv-8 flex flex-wrap gap-karv-3">
        {primaryCta && (
          <Button
            href={primaryCta.href}
            target={primaryCta.target}
            variant="primary"
            size="lg"
            data-event={primaryCta.event}
            data-location={primaryCta.location}
          >
            {primaryCta.label}
          </Button>
        )}
        {secondaryCta && (
          <Button
            href={secondaryCta.href}
            target={secondaryCta.target}
            variant="secondary"
            size="lg"
            data-event={secondaryCta.event}
            data-location={secondaryCta.location}
          >
            {secondaryCta.label}
          </Button>
        )}
      </div>
    )}
  </Container>
</Section>

<style>
  .hero {
    background:
      radial-gradient(circle at 78% 18%, rgb(167 123 72 / 18%), transparent 34rem),
      var(--color-bg);
  }

  .hero::before {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(112deg, rgb(24 21 19 / 28%), transparent 58%);
    content: "";
    pointer-events: none;
  }

  .hero__title {
    max-width: 16ch;
  }
</style>
