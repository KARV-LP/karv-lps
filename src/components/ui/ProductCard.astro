---
import { getLocaleFromPath, localizedHref } from "../../utils/i18n";

interface Props {
  title: string;
  description?: string;
  href?: string;
  label?: string;
}

const { title, description, href, label } = Astro.props;
const Tag = href ? "a" : "div";
const localizedCardHref = localizedHref(getLocaleFromPath(Astro.url.pathname), href);
---

<Tag
  href={localizedCardHref}
  class:list={[
    "product-card flex flex-col overflow-hidden rounded-karv-lg border border-karv-border bg-karv-ink-raised transition-[border-color,box-shadow,transform] duration-[var(--duration-fast)] ease-[var(--easing-standard)]",
  ]}
>
  <div class="product-card__media grid aspect-[16/10] place-items-center" aria-hidden="true">
    <span class="product-card__initial font-karv-display text-[2.5rem] font-bold text-karv-glow">{title.charAt(0)}</span>
  </div>
  <div class="product-card__body flex flex-1 flex-col gap-karv-2 p-karv-6">
    {label && (
      <span class="product-card__label font-karv-text text-karv-xs uppercase tracking-[0.14em] text-karv-glow">{label}</span>
    )}
    <h3 class="product-card__title font-karv-display text-karv-xl leading-karv-tight tracking-karv-tight">{title}</h3>
    {description && <p class="product-card__description text-karv-sm text-karv-greige">{description}</p>}
  </div>
</Tag>

<style>
  .product-card {
    box-shadow: inset 0 1px 0 rgb(241 236 228 / 5%);
  }

  a.product-card:hover {
    border-color: var(--color-accent);
    transform: translateY(-2px);
    box-shadow:
      inset 0 1px 0 rgb(232 213 181 / 14%),
      var(--shadow-contact);
  }

  .product-card__media {
    background: linear-gradient(135deg, var(--color-surface-soft), var(--color-bg));
  }

  .product-card__description {
    line-height: 1.5;
  }
</style>
