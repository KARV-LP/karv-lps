---
interface Props {
  size?: "default" | "narrow" | "wide";
  class?: string;
}

const { size = "default", class: className = "" } = Astro.props;
---

<div class:list={["container", `container--${size}`, className]}>
  <slot />
</div>

<style>
  .container {
    width: 100%;
    max-width: var(--container-width);
    margin-inline: auto;
    padding-inline: var(--space-4);
  }

  .container--narrow {
    max-width: 760px;
  }

  .container--wide {
    max-width: 1440px;
  }
</style>
