---
interface Props {
  size?: "default" | "narrow" | "wide";
  class?: string;
}

const { size = "default", class: className = "" } = Astro.props;
---

<div class:list={["karv-container", `karv-container--${size}`, "w-full max-w-karv mx-auto px-karv-4", className]}>
  <slot />
</div>

<style>
  .karv-container--narrow {
    max-width: 760px;
  }

  .karv-container--wide {
    max-width: 1440px;
  }
</style>
