---
import { getLocaleFromPath, localizedHref } from "../../utils/i18n";

interface Props {
  href?: string;
  variant?: "primary" | "secondary" | "ghost";
  size?: "md" | "lg";
  target?: string;
  type?: "button" | "submit" | "reset";
  class?: string;
  [key: string]: unknown;
}

const {
  href,
  variant = "primary",
  size = "md",
  target,
  type = "button",
  class: className = "",
  ...attrs
} = Astro.props;

const Tag = href ? "a" : "button";
const localizedButtonHref = localizedHref(getLocaleFromPath(Astro.url.pathname), href);
---

<Tag
  {...attrs}
  href={localizedButtonHref}
  target={target}
  type={href ? undefined : type}
  rel={target === "_blank" ? "noopener noreferrer" : undefined}
  class:list={[
    "btn",
    "inline-flex min-h-11 items-center justify-center gap-karv-2 rounded-karv-pill border font-karv-text text-karv-sm font-semibold tracking-[0.02em] transition-[background,color,border-color,box-shadow,transform] duration-[var(--duration-fast)] ease-[var(--easing-standard)]",
    {
      "px-karv-6 py-karv-3": size === "md",
      "px-karv-8 py-karv-4 text-[15px]": size === "lg",
    },
    `btn--${variant}`,
    className,
  ]}
>
  <slot />
</Tag>

<style>
  .btn {
    cursor: pointer;
    border-color: transparent;
  }

  .btn--primary {
    background: linear-gradient(135deg, var(--color-glow) -35%, var(--color-bronze) 52%, var(--color-bronze-ink));
    box-shadow:
      inset 0 1px 0 rgb(241 236 228 / 40%),
      var(--shadow-contact);
    color: var(--color-ink);
  }

  .btn--primary:hover {
    transform: translateY(-1px);
    box-shadow:
      inset 0 1px 0 rgb(241 236 228 / 55%),
      0 10px 28px rgb(24 21 19 / 26%);
  }

  .btn--secondary {
    background: transparent;
    border-color: var(--color-border);
    color: var(--color-text);
  }

  .btn--secondary:hover {
    border-color: var(--color-accent);
    color: var(--color-accent-soft);
  }

  .btn--ghost {
    background: transparent;
    color: var(--color-muted);
  }

  .btn--ghost:hover {
    color: var(--color-accent-soft);
  }
</style>
